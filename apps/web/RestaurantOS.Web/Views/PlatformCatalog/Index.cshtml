@model RestaurantOS.Web.Models.PlatformCatalogPageViewModel
@{
    Layout = "_PlatformLayout";
    ViewData["Title"] = "Planlar ve fiyatlar";
    string Money(long minor, string currency) =>
        $"{(minor / 100m).ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))} {currency}";
    string StatusLabel(string status) => status switch
    {
        "published" => "Yayınlı",
        "draft" => "Taslak",
        "archived" => "Arşiv",
        _ => status,
    };
    string IntervalLabel(string interval) => interval == "year" ? "Yıllık" : "Aylık";
}

<div class="page-head">
    <div>
        <h1>Planlar ve fiyatlar</h1>
        <p class="muted">@(string.IsNullOrWhiteSpace(Model.Note) ? "Yayınlanan fiyat yeni yükseltmelerde geçerlidir." : Model.Note)</p>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert" role="alert">@error</div>
}

<div asp-validation-summary="All" class="alert"></div>

<section class="panel">
    <h2>Yeni fiyat taslağı</h2>
    <form action="/platform/catalog" method="post" class="form-grid-wide">
        @Html.AntiForgeryToken()
        <label>
            Ürün
            <select asp-for="Create.ProductCode">
                <option value="Free">Free</option>
                <option value="Pro">Pro</option>
                <option value="Enterprise">Enterprise</option>
                <option value="ExtraBranch">Ek şube</option>
            </select>
        </label>
        <label>
            Aralık
            <select asp-for="Create.Interval">
                <option value="month">Aylık</option>
                <option value="year">Yıllık</option>
            </select>
        </label>
        <label>
            Tutar (KDV dahil, ₺)
            <input asp-for="Create.Amount" />
            <span asp-validation-for="Create.Amount" class="field-error"></span>
        </label>
        <div class="form-actions">
            <button type="submit" class="btn">Taslak oluştur</button>
        </div>
    </form>
</section>

@foreach (var product in Model.Products)
{
    <section class="panel">
        <h2>
            @product.DisplayName
            <span class="muted">@(product.ProductKind == "addon" ? "ek ürün" : "plan")</span>
        </h2>
        @if (product.Prices.Count == 0)
        {
            <p class="muted">Bu üründe fiyat yok.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Aralık</th>
                        <th>Tutar</th>
                        <th>Durum</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var price in product.Prices)
                {
                    <tr>
                        <td>@IntervalLabel(price.Interval)</td>
                        <td>@Money(price.AmountMinor, price.Currency)</td>
                        <td>
                            <span class="badge @(price.Status == "published" ? "badge-ok" : "badge-muted")">
                                @StatusLabel(price.Status)
                            </span>
                        </td>
                        <td>
                            @if (price.Status == "draft")
                            {
                                <form action="/platform/catalog/publish" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@price.Id" />
                                    <button type="submit" class="linkish">Yayınla</button>
                                </form>
                                <form action="/platform/catalog/archive" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@price.Id" />
                                    <button type="submit" class="linkish">Arşivle</button>
                                </form>
                            }
                            else if (price.Status == "published")
                            {
                                <form action="/platform/catalog/archive" method="post" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@price.Id" />
                                    <button type="submit" class="linkish">Arşivle</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
