@model RestaurantOS.Web.Models.BranchesPageViewModel
@{
    ViewData["Title"] = "Şubeler";
    var workspace = Model.Workspace;
    var selected = Model.SelectedBranchId;
    var billing = Model.Billing;
    var entitlements = workspace?.Entitlements;
    var maxLabel = (billing?.MaxBranches ?? Model.MaxBranches)?.ToString() ?? "∞";
    var addonPrice = ((billing?.ExtraBranchMonthlyPriceMinor ?? entitlements?.ExtraBranchMonthlyPriceMinor ?? 0) / 100m).ToString("N2");
    var currency = billing?.Currency ?? entitlements?.BillingCurrency ?? "TRY";
    var addonRequired = TempData["AddonRequired"] as string == "1" || billing?.NextBranchRequiresAddon == true;
}

<div class="page-head">
    <div>
        <h1>Şube ağı</h1>
        <p class="muted">Merkezden şube açın, hesap verin ve tüm şubelerin özetini izleyin.</p>
    </div>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert" role="alert">@error</div>
}
@if (TempData["Message"] is string message)
{
    <div class="alert alert--success" role="status">@message</div>
}

@if (workspace is null)
{
    <p class="muted">Çalışma alanı yüklenemedi.</p>
}
else
{
    @if (billing is not null || entitlements is not null)
    {
        <section class="panel">
            <h2 style="margin-top:0">Plan ve şube kotası</h2>
            <p>@(billing?.Summary ?? entitlements?.PlanDisplayName)</p>
            <div class="stat-row">
                <div>
                    <div class="stat-label">Plan</div>
                    <div class="stat-value" style="font-size:1rem">@(billing?.PlanDisplayName ?? entitlements?.PlanDisplayName)</div>
                </div>
                <div>
                    <div class="stat-label">Aktif / kota</div>
                    <div class="stat-value" style="font-size:1rem">@(billing?.ActiveBranchCount ?? entitlements?.ActiveBranchCount ?? entitlements?.BranchCount) / @maxLabel</div>
                </div>
                <div>
                    <div class="stat-label">Dahil + ek koltuk</div>
                    <div class="stat-value" style="font-size:1rem">@(billing?.IncludedBranches ?? entitlements?.IncludedBranches) + @(billing?.PurchasedBranchAddonCount ?? entitlements?.PurchasedBranchAddonCount)</div>
                </div>
                <div>
                    <div class="stat-label">Dondurulmuş</div>
                    <div class="stat-value" style="font-size:1rem">@(billing?.FrozenBranchCount ?? entitlements?.FrozenBranchCount)</div>
                </div>
            </div>
            @if (entitlements?.Warnings is { Count: > 0 })
            {
                <ul style="margin:1rem 0 0">
                    @foreach (var warning in entitlements.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
            @if (entitlements?.PlanCode == "Free" || (billing?.FrozenBranchCount ?? 0) > 0)
            {
                <form asp-action="UpgradePro" method="post" style="margin-top:1rem" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn">Pro’ya geç (2 şube dahil)</button>
                </form>
            }
        </section>
    }

    @if (!Model.CanUseMultiBranch)
    {
        var multiPrompt = MonetizationUi.FromFeature(RestaurantOS.Domain.MonetizationPolicy.MultiBranchFeature, "warn");
        <section class="panel panel-locked" style="margin-top:1rem">
            <partial name="_UpgradePrompt" model="multiPrompt" />
            <p class="muted" style="margin:0.75rem 0 0">
                Ücretli Pro’da 2 şube dahildir; ek şube @addonPrice @currency / ay.
            </p>
        </section>
    }

    @if (Model.Memberships.Count > 1)
    {
        <section class="panel" style="margin-top:1rem">
            <h2 style="margin-top:0">Aktif şube</h2>
            <div class="branch-switcher">
                @foreach (var membership in Model.Memberships)
                {
                    var isCurrent = membership.BranchId == workspace.BranchId;
                    if (isCurrent)
                    {
                        <span class="chip chip-active">@membership.BranchName · şu an</span>
                    }
                    else
                    {
                        <form asp-action="Switch" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="branchId" value="@membership.BranchId" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Branches")" />
                            <button type="submit" class="btn btn-ghost">@membership.BranchName</button>
                        </form>
                    }
                }
            </div>
        </section>
    }

    @if (Model.CanManageBranches)
    {
        @if (Model.Network is not null)
        {
            <section class="panel" style="margin-top:1rem">
                <h2 style="margin-top:0">Ağ özeti (son 7 gün)</h2>
                <div class="stat-row">
                    <div>
                        <div class="stat-label">Ciro</div>
                        <div class="stat-value">@((Model.Network.GrossSalesMinor / 100m).ToString("N2")) @Model.Network.Currency</div>
                    </div>
                    <div>
                        <div class="stat-label">Tamamlanan</div>
                        <div class="stat-value">@Model.Network.CompletedOrderCount</div>
                    </div>
                    <div>
                        <div class="stat-label">Açık sipariş</div>
                        <div class="stat-value">@Model.Network.OpenOrderCount</div>
                    </div>
                    <div>
                        <div class="stat-label">Şube</div>
                        <div class="stat-value">@Model.Network.BranchCount / @maxLabel</div>
                    </div>
                </div>
            </section>
        }

        <section class="panel @(Model.CanUseMultiBranch ? "" : "panel-disabled")" style="margin-top:1rem">
            <h2 style="margin-top:0">Yeni şube aç</h2>
            @if (Model.CanUseMultiBranch)
            {
                <form asp-action="Create" method="post" class="form-grid">
                    @Html.AntiForgeryToken()
                    <label>
                        <span>Şube adı</span>
                        <input asp-for="CreateBranch.Name" placeholder="Örn. Kadıköy şubesi" />
                    </label>
                    @if (addonRequired && billing is { IsTrial: false, PlanCode: "Pro" })
                    {
                        <label class="span-2">
                            <input asp-for="CreateBranch.ConfirmAddonPurchase" type="checkbox" />
                            <span>Ek şube koltuğunu onaylıyorum (+@addonPrice @currency / ay). Ödeme altyapısı bağlanana kadar faturalama kaydı oluşturulur.</span>
                        </label>
                    }
                    <div class="span-2">
                        <button type="submit" class="btn">Şube oluştur</button>
                    </div>
                </form>
            }
            else
            {
                <p class="muted">Free planda yeni şube açılamaz.</p>
            }
        </section>

        <section class="panel" style="margin-top:1rem">
            <h2 style="margin-top:0">Şubeler</h2>
            <div class="branch-list">
                @foreach (var branch in Model.Branches)
                {
                    <article class="branch-card @(branch.Id == selected ? "branch-card-active" : "") @(branch.IsFrozen ? "panel-disabled" : "")">
                        <div class="panel-head">
                            <div>
                                <h3 style="margin:0">
                                    @branch.Name
                                    @if (branch.IsFrozen)
                                    {
                                        <span class="chip">Donduruldu</span>
                                    }
                                </h3>
                                <p class="muted">@branch.ActiveMemberCount hesap · @branch.ActiveTableCount masa</p>
                            </div>
                            <div class="branch-card-actions">
                                @if (!branch.IsCurrent)
                                {
                                    <form asp-action="Switch" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="branchId" value="@branch.Id" />
                                        <button type="submit" class="btn btn-ghost">Bu şubeye geç</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="chip chip-active">Aktif</span>
                                }
                                <a class="btn btn-ghost" asp-action="Index" asp-route-branchId="@branch.Id">Hesaplar</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        @if (Model.CanManageMembers && selected is Guid selectedBranchId)
        {
            var selectedBranch = Model.Branches.FirstOrDefault(x => x.Id == selectedBranchId)
                ?? new BranchListItemViewModel
                {
                    Id = selectedBranchId,
                    Name = Model.Workspace?.BranchName ?? "Şube",
                    IsCurrent = true,
                };
            <section class="panel" style="margin-top:1rem" id="branch-accounts-panel">
                @{
                    ViewData["AccountsBranch"] = selectedBranch;
                }
                <partial name="_BranchAccounts" model="Model" />
            </section>
        }

        <section class="panel" style="margin-top:1rem">
            <h2 style="margin-top:0">Enterprise teklif</h2>
            <p class="muted">5+ şube, öncelikli destek ve özel sözleşme için teklif alın. Self-serve Enterprise yok.</p>
            <form asp-action="RequestEnterpriseQuote" method="post" class="form-grid form-grid-wide">
                @Html.AntiForgeryToken()
                <label>
                    <span>Yetkili adı</span>
                    <input asp-for="EnterpriseQuote.ContactName" />
                </label>
                <label>
                    <span>E-posta</span>
                    <input asp-for="EnterpriseQuote.Email" />
                </label>
                <label>
                    <span>Telefon</span>
                    <input asp-for="EnterpriseQuote.Phone" />
                </label>
                <label>
                    <span>Tahmini şube</span>
                    <input asp-for="EnterpriseQuote.EstimatedBranchCount" type="number" min="3" />
                </label>
                <label class="span-2">
                    <span>Not</span>
                    <textarea asp-for="EnterpriseQuote.Note" rows="3"></textarea>
                </label>
                <div class="span-2">
                    <button type="submit" class="btn">Teklif talep et</button>
                </div>
            </form>
        </section>
    }
    else
    {
        <section class="panel" style="margin-top:1rem">
            <h2 style="margin-top:0">Erişiminiz olan şubeler</h2>
            <ul>
                @foreach (var branch in Model.Branches)
                {
                    <li>
                        @branch.Name
                        @if (branch.IsCurrent)
                        {
                            <span class="chip chip-active">aktif</span>
                        }
                        @if (branch.IsFrozen)
                        {
                            <span class="chip">donduruldu</span>
                        }
                    </li>
                }
            </ul>
        </section>

        @if (Model.CanManageMembers && Model.SelectedBranchId is Guid managerAccountsBranchId)
        {
            var accountsBranch = Model.Branches.FirstOrDefault(x => x.Id == managerAccountsBranchId)
                ?? new BranchListItemViewModel
                {
                    Id = managerAccountsBranchId,
                    Name = Model.Workspace?.BranchName ?? "Şube",
                    IsCurrent = true,
                };
            <section class="panel" style="margin-top:1rem" id="branch-accounts-panel">
                @{
                    ViewData["AccountsBranch"] = accountsBranch;
                }
                <partial name="_BranchAccounts" model="Model" />
            </section>
        }
    }
}
