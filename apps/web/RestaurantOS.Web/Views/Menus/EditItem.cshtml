@model RestaurantOS.Web.Models.EditMenuItemViewModel
@{
    ViewData["Title"] = "Ürün düzenle";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Menü</p>
        <h1>Ürün düzenle</h1>
    </div>
    <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.MenuId">Geri</a>
</div>

<div asp-validation-summary="All" class="alert"></div>

<form asp-action="EditItem" method="post" enctype="multipart/form-data" class="form-grid form-grid-wide panel">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="MenuId" />
    <label>
        Kategori
        <select asp-for="CategoryId">
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </label>
    <label>
        Ürün adı
        <input asp-for="Name" />
    </label>
    @if (ViewData["CanUseProductImages"] as bool? == true)
    {
        <partial name="_MenuItemImagePicker" model="@(new MenuItemImageFieldsViewModel
        {
            ImageUrl = Model.ImageUrl,
            ImageAlt = Model.ImageAlt,
            PreviewImageUrl = Model.PreviewImageUrl,
            NameInputId = "Name",
        })" />
    }
    else
    {
        <p class="muted span-2">Ürün fotoğrafı bu hesap için kapalı. Yöneticinizle veya destek ile plan ayarlarını kontrol edin.</p>
    }
    <label class="span-2">
        Açıklama
        <input asp-for="Description" />
    </label>
    <label class="narrow">
        Fiyat (₺)
        <input asp-for="PriceTry" inputmode="decimal" />
    </label>
    <label class="narrow">
        Sıra
        <input asp-for="SortOrder" />
    </label>
    <label class="narrow">
        Hazırlama (dk)
        <input asp-for="PrepMinutes" inputmode="numeric" />
    </label>
    <label class="narrow">
        Hazırlama (sn)
        <input asp-for="PrepSeconds" inputmode="numeric" />
    </label>
    <p class="muted span-2">Boş bırakılırsa ürün özel süresi kaldırılır; siparişlerde varsayılan süre kullanılır.</p>
    <label class="check">
        <input asp-for="IsAvailable" />
        Satışa açık
    </label>
    @{
        ViewData.TemplateInfo.HtmlFieldPrefix = "Catalog";
    }
    <partial name="_MenuItemCatalogFields" model="Model.Catalog" />
    @{
        ViewData.TemplateInfo.HtmlFieldPrefix = string.Empty;
    }
    <div class="form-actions span-2">
        <button type="submit" class="btn">Kaydet</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/stock-photo-picker.js" asp-append-version="true"></script>
    <script src="~/js/custom-labels.js" asp-append-version="true"></script>
}
