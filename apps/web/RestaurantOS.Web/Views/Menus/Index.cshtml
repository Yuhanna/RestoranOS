@model IReadOnlyList<RestaurantOS.Web.Models.MenuSummaryViewModel>
@{
    ViewData["Title"] = "Menüler";
}

<div class="page-head">
    <h1>Menüler</h1>
    <a class="btn" asp-action="Create">Yeni menü</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p class="muted">Henüz menü oluşturulmamış.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Ad</th>
                <th>Durum</th>
                <th>Kategori</th>
                <th>Ürün</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var menu in Model)
        {
            <tr>
                <td>@menu.Name</td>
                <td>@menu.Lifecycle</td>
                <td>@menu.CategoryCount</td>
                <td>@menu.ItemCount</td>
                <td><a asp-action="Details" asp-route-id="@menu.Id">Aç</a></td>
            </tr>
        }
        </tbody>
    </table>
}
