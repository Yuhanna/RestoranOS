@model RestaurantOS.Web.Models.AdminLoginViewModel
@inject IHostEnvironment HostEnvironment
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Pasa Admin girişi";
}

<section class="auth-card">
    <p class="eyebrow">PASA ADMIN</p>
    <h1>Site yönetimi girişi</h1>
    <p class="lede">Bu sayfa geçici MVC iskeletidir. Pasa Admin ayrı alt alandadır: <strong>admin.pasa.app</strong>.</p>

    @if (HostEnvironment.IsDevelopment())
    {
        <div class="alert" role="note">
            Asıl Pasa Admin yerelde <a href="http://localhost:5175">http://localhost:5175</a>
            (<code>apps/admin-web</code>) üzerinde çalışır. Bu host restoran MVC ile aynıdır
            (<code>localhost:5288</code> / <code>app.pasa.app</code>) ve subdomain hedefi değildir.
        </div>
        <div class="alert success" role="note">
            <strong>Site sahibi hesabı:</strong> <code>platform@local.test</code> / <code>Local-Dev-Pass!42</code><br />
            <code>owner@local.test</code> yalnızca restoran paneli içindir — bu sayfada kullanılamaz.
            API yeniden başlatıldığında platform hesabı otomatik oluşturulur.
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert" role="alert">@Model.ErrorMessage</div>
    }

    <form action="/admin/account/login" method="post" class="stack" autocomplete="on">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Context.Request.Query["returnUrl"]" />
        <label>
            E-posta
            <input asp-for="Email" autocomplete="username" inputmode="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </label>
        <label>
            Parola
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </label>
        <button type="submit" class="btn">Admin girişi</button>
    </form>

    <p class="auth-switch muted">
        Restoran paneli için <a href="/Account/Login">standart giriş</a> kullanın.
    </p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
