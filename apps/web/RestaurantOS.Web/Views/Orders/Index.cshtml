@model IReadOnlyList<RestaurantOS.Web.Models.OrderListItemViewModel>
@using Microsoft.Extensions.Options
@using RestaurantOS.Web.Data
@inject IWebApiExecuter Api
@inject IOptions<ApiOptions> ApiOptions
@{
    ViewData["Title"] = "Aktif siparişler";
    var apiBase = ApiOptions.Value.BaseUrl.TrimEnd('/');
    var accessToken = Api.CurrentToken?.AccessToken ?? string.Empty;
    string StatusTr(string status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "Alındı",
        "accepted" => "Onaylandı",
        "preparing" => "Hazırlanıyor",
        "ready" => "Hazır",
        "served" => "Servis edildi",
        "completed" => "Hesap kapandı",
        "cancelled" => "İptal",
        _ => status ?? "—"
    };
    string StatusBadgeClass(string? status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "badge-status-submitted",
        "accepted" => "badge-status-accepted",
        "preparing" => "badge-status-preparing",
        "ready" => "badge-status-ready",
        "served" => "badge-status-served",
        "completed" => "badge-status-completed",
        "cancelled" => "badge-status-cancelled",
        _ => "badge-warn"
    };
    var tableGroups = Model
        .GroupBy(order => order.TableId)
        .Select(group =>
        {
            var rounds = group.OrderBy(order => order.CreatedAtUtc ?? order.StatusChangedAtUtc).ToList();
            return new
            {
                TableId = group.Key,
                TableLabel = rounds[0].TableLabel,
                Rounds = rounds,
                TotalMinor = rounds.Sum(order => order.AmountMinor),
                HasIncomplete = rounds.Any(order =>
                {
                    var s = order.Status?.ToLowerInvariant();
                    return s is "submitted" or "accepted" or "preparing";
                }),
            };
        })
        .OrderByDescending(group => group.HasIncomplete)
        .ThenByDescending(group => group.Rounds.Max(order => order.CreatedAtUtc ?? order.StatusChangedAtUtc))
        .ToList();
}

<div class="page-head">
    <div>
        <h1>Aktif siparişler</h1>
        <p class="muted" id="orders-live-status" role="status">Canlı bağlantı kuruluyor…</p>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-ghost" asp-action="History">Sipariş geçmişi</a>
        <button type="button" class="btn btn-ghost" id="orders-sound-toggle" aria-pressed="true">
            Zil sesi: Açık
        </button>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert" role="alert">@error</div>
}
<div id="orders-toast" class="alert success hidden" role="status"></div>

<section class="panel" style="margin-bottom:1.25rem">
    <div class="page-head" style="margin-bottom:0.75rem">
        <h2 style="margin:0;font-size:1.1rem">Garson / servis çağrıları</h2>
        <p class="muted" id="service-requests-empty">Açık çağrı yok.</p>
    </div>
    <div class="item-grid" id="service-requests-grid"></div>
</section>

<div id="orders-empty" class="@(Model.Count == 0 ? null : "hidden")">
    <p class="muted">Şu anda aktif sipariş yok. Yeni siparişler anında burada görünür.</p>
</div>

<div id="orders-by-table" class="table-order-list">
    @foreach (var group in tableGroups)
    {
        <section class="table-order-group table-order-group--accent-@((group.TableId.GetHashCode() & 0x7FFFFFFF) % 6) @(group.HasIncomplete ? "table-order-group--kitchen" : "table-order-group--settle")" data-table-id="@group.TableId">
            <header class="table-order-group__head">
                <div>
                    <h2 class="table-order-group__title">@(string.IsNullOrWhiteSpace(group.TableLabel) ? "—" : group.TableLabel)</h2>
                    <p class="muted table-order-group__meta">
                        <span class="table-round-count">@group.Rounds.Count tur</span>
                        · masa toplamı
                        <strong class="table-total">₺@((group.TotalMinor / 100m).ToString("N2"))</strong>
                    </p>
                </div>
                <button type="button"
                        class="btn table-close-check @(group.HasIncomplete ? "btn-ghost table-close-check--muted" : "table-close-check--ready")"
                        data-table-id="@group.TableId"
                        data-table-label="@(group.TableLabel ?? "")"
                        title="@(group.HasIncomplete ? "Mutfak henüz bitmedi — önce turları ilerletin veya onaylayarak kapatın" : "Tüm turlar hazır/servis — hesabı kapatabilirsiniz")">
                    Hesabı kapat
                </button>
            </header>
            <div class="item-grid table-order-group__rounds">
                @foreach (var order in group.Rounds)
                {
                    <article class="item-card"
                             data-order-id="@order.Id"
                             data-table-id="@order.TableId"
                             data-status="@order.Status"
                             data-status-changed="@order.StatusChangedAtUtc.ToString("O")"
                             data-amount-minor="@order.AmountMinor"
                             data-created="@(order.CreatedAtUtc?.ToString("O") ?? "")"
                             data-estimated-ready="@order.EstimatedReadyAtUtc.ToString("O")"
                             data-display="@order.DisplayNumber"
                             data-table-label="@(order.TableLabel ?? "")"
                             data-currency="@order.Currency"
                             data-item-summary="@(order.ItemSummary ?? "")">
                        <div class="item-card-top">
                            <h3>@order.DisplayNumber</h3>
                            <span class="price">₺@((order.AmountMinor / 100m).ToString("N2"))</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(order.ItemSummary))
                        {
                            <p class="order-item-summary">@order.ItemSummary</p>
                        }
                        <p class="item-desc">
                            Durum: <strong class="order-status-label">@StatusTr(order.Status)</strong><br />
                            Sipariş: <span class="order-created">@(order.CreatedAtUtc?.ToLocalTime().ToString("g") ?? "—")</span><br />
                            Güncelleme: <span class="order-changed">@order.StatusChangedAtUtc.ToLocalTime().ToString("g")</span>
                        </p>
                        <div class="item-meta">
                            <span class="badge @StatusBadgeClass(order.Status) order-status-code">@StatusTr(order.Status)</span>
                            <a class="linkish"
                               asp-action="Detail"
                               asp-route-id="@order.Id">Detay</a>
                            @if (order.Status is not "served" and not "completed" and not "cancelled")
                            {
                                <button type="button" class="linkish order-change-link">Durumu değiştir</button>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

<dialog id="status-change-dialog" class="ros-dialog">
    <form method="dialog" id="status-change-form" class="ros-dialog__body">
        <header class="ros-dialog__head">
            <h2 id="status-change-title">Durumu değiştir</h2>
            <p class="muted" id="status-change-summary"></p>
        </header>
        <label class="ros-dialog__note">
            <span>Yeni durum</span>
            <select id="status-change-select"></select>
        </label>
        <label class="ros-dialog__note">
            <span>Tahmini hazır <span class="opt">opsiyonel</span></span>
            <input type="text" id="status-change-eta" inputmode="numeric" maxlength="8" placeholder="örn. 15 veya 09:23" autocomplete="off" />
        </label>
        <p class="muted">Dakika (15) veya saat (09:23). Boş = mevcut ETA korunur. Hesap kapanışı masa kartındaki <strong>Hesabı kapat</strong> ile yapılır.</p>
        <p id="status-change-error" class="alert hidden" role="alert"></p>
        <footer class="ros-dialog__actions">
            <button type="button" class="btn btn-ghost" id="status-change-cancel">Vazgeç</button>
            <button type="submit" class="btn" id="status-change-submit">Kaydet</button>
        </footer>
    </form>
</dialog>

<dialog id="close-check-dialog" class="ros-dialog">
    <form method="dialog" id="close-check-form" class="ros-dialog__body">
        <header class="ros-dialog__head">
            <h2 id="close-check-title">Hesabı kapat</h2>
            <p class="muted" id="close-check-summary"></p>
        </header>
        <div id="close-check-rounds" class="close-check-rounds" aria-live="polite"></div>
        <fieldset class="ros-dialog__fieldset">
            <legend>Tahsilat yöntemi</legend>
            <label class="ros-choice"><input type="radio" name="tender" value="cash" checked /> Nakit</label>
            <label class="ros-choice"><input type="radio" name="tender" value="card" /> Kart</label>
            <label class="ros-choice"><input type="radio" name="tender" value="other" /> Diğer</label>
        </fieldset>
        <label class="ros-dialog__note">
            <span>Not <span class="opt">opsiyonel</span></span>
            <input type="text" id="close-check-note" maxlength="120" placeholder="Örn. fiş kesildi" />
        </label>
        <div id="close-check-incomplete" class="alert hidden" role="alert">
            Mutfakta hâlâ hazırlanan tur var. Onaylarsanız tüm turlar tamamlandı sayılır ve masa boşaltılır.
            <label class="ros-choice" style="margin-top:0.5rem">
                <input type="checkbox" id="close-check-force" />
                Yine de hesabı kapat
            </label>
        </div>
        <p id="close-check-error" class="alert hidden" role="alert"></p>
        <footer class="ros-dialog__actions">
            <button type="button" class="btn btn-ghost" id="close-check-cancel" value="cancel">Vazgeç</button>
            <button type="submit" class="btn" id="close-check-submit">Hesabı kapat</button>
        </footer>
    </form>
</dialog>

@section Scripts {
    <script>
        (() => {
            window.__restaurantOsOrdersPageActive = true;
            const alerts = window.RestaurantOsAlerts;
            const apiBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const accessToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accessToken));
            const statusEl = document.getElementById("orders-live-status");
            const listEl = document.getElementById("orders-by-table");
            const emptyEl = document.getElementById("orders-empty");
            const toastEl = document.getElementById("orders-toast");
            const serviceGrid = document.getElementById("service-requests-grid");
            const serviceEmpty = document.getElementById("service-requests-empty");
            const soundToggle = document.getElementById("orders-sound-toggle");
            const dialog = document.getElementById("close-check-dialog");
            const form = document.getElementById("close-check-form");
            const incompleteBox = document.getElementById("close-check-incomplete");
            const forceBox = document.getElementById("close-check-force");
            const errorEl = document.getElementById("close-check-error");
            const summaryEl = document.getElementById("close-check-summary");
            const titleEl = document.getElementById("close-check-title");
            const noteEl = document.getElementById("close-check-note");
            const roundsDetailEl = document.getElementById("close-check-rounds");
            const cancelBtn = document.getElementById("close-check-cancel");
            const statusDialog = document.getElementById("status-change-dialog");
            const statusForm = document.getElementById("status-change-form");
            const statusTitle = document.getElementById("status-change-title");
            const statusSummary = document.getElementById("status-change-summary");
            const statusSelect = document.getElementById("status-change-select");
            const statusEta = document.getElementById("status-change-eta");
            const statusError = document.getElementById("status-change-error");
            const statusCancel = document.getElementById("status-change-cancel");
            const statusSubmit = document.getElementById("status-change-submit");
            let activeStatusOrderId = null;

            /** @@type {Map<string, object>} */
            const ordersById = new Map();

            if (!apiBase || !accessToken || !window.signalR) {
                if (statusEl) statusEl.textContent = "Canlı bağlantı kullanılamıyor; sayfayı yenileyerek güncelleyin.";
            }

            const statusTr = {
                submitted: "Alındı",
                accepted: "Onaylandı",
                preparing: "Hazırlanıyor",
                ready: "Hazır",
                served: "Servis edildi",
                completed: "Hesap kapandı",
                cancelled: "İptal"
            };
            const statusOptionLabels = {
                accepted: "Onaylandı",
                preparing: "Hazırlanıyor",
                ready: "Hazır / pasa çıktı",
                served: "Servis edildi",
                cancelled: "İptal"
            };
            function statusBadgeClass(status) {
                switch ((status || "").toLowerCase()) {
                    case "submitted": return "badge-status-submitted";
                    case "accepted": return "badge-status-accepted";
                    case "preparing": return "badge-status-preparing";
                    case "ready": return "badge-status-ready";
                    case "served": return "badge-status-served";
                    case "completed": return "badge-status-completed";
                    case "cancelled": return "badge-status-cancelled";
                    default: return "badge-warn";
                }
            }
            function statusRank(status) {
                switch ((status || "").toLowerCase()) {
                    case "submitted": return 0;
                    case "accepted": return 1;
                    case "preparing": return 2;
                    case "ready": return 3;
                    case "served": return 4;
                    case "completed": return 5;
                    default: return -1;
                }
            }
            function allowedStatusTargets(current) {
                const cur = (current || "").toLowerCase();
                return ["accepted", "preparing", "ready", "served", "cancelled"].filter((candidate) => {
                    if (candidate === "cancelled") {
                        return cur === "submitted" || cur === "accepted" || cur === "preparing";
                    }
                    return statusRank(candidate) > statusRank(cur);
                });
            }
            function parseEtaInput(raw) {
                const value = (raw || "").trim();
                if (!value) return null;
                if (/^\d{1,3}$/.test(value)) {
                    const minutes = Number(value);
                    if (minutes <= 0) return null;
                    return new Date(Date.now() + minutes * 60_000).toISOString();
                }
                const match = value.match(/^(\d{1,2}):(\d{2})$/);
                if (!match) return null;
                const hours = Number(match[1]);
                const mins = Number(match[2]);
                if (hours > 23 || mins > 59) return null;
                const target = new Date();
                target.setSeconds(0, 0);
                target.setHours(hours, mins, 0, 0);
                if (target.getTime() <= Date.now()) {
                    target.setDate(target.getDate() + 1);
                }
                return target.toISOString();
            }
            const requestTypeTr = {
                waiter: "Garson çağrısı",
                bill: "Hesap isteği",
                water: "Su isteği",
                cutlery: "Çatal-bıçak",
                napkin: "Peçete",
                other: "Diğer çağrı"
            };

            function syncSoundToggle(state) {
                if (!soundToggle || !alerts) return;
                const enabled = state ? state.soundEnabled : alerts.isSoundEnabled();
                const unlocked = state ? state.audioUnlocked : alerts.isAudioUnlocked();
                soundToggle.setAttribute("aria-pressed", enabled ? "true" : "false");
                soundToggle.textContent = enabled
                    ? (unlocked ? "Zil sesi: Açık" : "Zil sesi: Açık (etkileşim bekleniyor)")
                    : "Zil sesi: Kapalı";
            }

            function playAlertChime(kind, options) {
                if (alerts) alerts.play(kind, options);
            }

            if (alerts) {
                alerts.onSoundState(syncSoundToggle);
                if (soundToggle) {
                    soundToggle.addEventListener("click", async () => {
                        alerts.unlock();
                        const next = !alerts.isSoundEnabled();
                        alerts.setSoundEnabled(next);
                        if (next) {
                            await alerts.requestNotificationPermission();
                            playAlertChime("order", { force: true });
                        }
                        syncSoundToggle();
                    });
                }
            } else {
                syncSoundToggle({ soundEnabled: true, audioUnlocked: false });
            }

            function formatMoney(amountMinor) {
                return "₺" + (Number(amountMinor) / 100).toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function formatLocal(iso) {
                if (!iso) return "—";
                const d = new Date(iso);
                return Number.isNaN(d.getTime()) ? "—" : d.toLocaleString("tr-TR");
            }

            function setLiveState(text) {
                if (statusEl) statusEl.textContent = text;
            }

            function showToast(text) {
                if (!toastEl) return;
                toastEl.textContent = text;
                toastEl.classList.remove("hidden");
                window.setTimeout(() => toastEl.classList.add("hidden"), 5000);
            }

            function isKitchenIncomplete(status) {
                const s = (status || "").toLowerCase();
                return s === "submitted" || s === "accepted" || s === "preparing";
            }

            function seedFromDom() {
                listEl.querySelectorAll("article.item-card[data-order-id]").forEach((el) => {
                    ordersById.set(el.dataset.orderId, {
                        id: el.dataset.orderId,
                        tableId: el.dataset.tableId,
                        tableLabel: el.dataset.tableLabel || "",
                        displayNumber: el.dataset.display || "",
                        status: el.dataset.status || "",
                        statusChangedAtUtc: el.dataset.statusChanged || "",
                        createdAtUtc: el.dataset.created || null,
                        estimatedReadyAtUtc: el.dataset.estimatedReady || "",
                        amountMinor: Number(el.dataset.amountMinor || 0),
                        currency: el.dataset.currency || "TRY",
                        itemSummary: el.dataset.itemSummary || ""
                    });
                });
                if (alerts) alerts.seedKnownOrders([...ordersById.keys()]);
            }

            function detailUrl(order) {
                return "/Orders/Detail?id=" + encodeURIComponent(order.id);
            }

            function emptyGuid(value) {
                return !value || value === "00000000-0000-0000-0000-000000000000";
            }

            function groupOrders() {
                const byTable = new Map();
                for (const order of ordersById.values()) {
                    const key = emptyGuid(order.tableId)
                        ? ("label:" + (order.tableLabel || "—"))
                        : order.tableId;
                    if (!byTable.has(key)) byTable.set(key, []);
                    byTable.get(key).push(order);
                }
                const groups = [];
                for (const [tableId, rounds] of byTable) {
                    rounds.sort((a, b) => new Date(a.createdAtUtc || a.statusChangedAtUtc) - new Date(b.createdAtUtc || b.statusChangedAtUtc));
                    const hasIncomplete = rounds.some((r) => isKitchenIncomplete(r.status));
                    const newest = Math.max(...rounds.map((r) => new Date(r.createdAtUtc || r.statusChangedAtUtc).getTime()));
                    groups.push({
                        tableId,
                        tableLabel: rounds[0].tableLabel || "—",
                        rounds,
                        totalMinor: rounds.reduce((sum, r) => sum + Number(r.amountMinor || 0), 0),
                        hasIncomplete,
                        newest
                    });
                }
                groups.sort((a, b) => {
                    if (a.hasIncomplete !== b.hasIncomplete) return a.hasIncomplete ? -1 : 1;
                    return b.newest - a.newest;
                });
                return groups;
            }

            function tableAccentIndex(tableId) {
                const raw = String(tableId || "");
                let hash = 0;
                for (let i = 0; i < raw.length; i++) {
                    hash = ((hash << 5) - hash) + raw.charCodeAt(i);
                    hash |= 0;
                }
                return Math.abs(hash) % 6;
            }

            function renderOrders() {
                const groups = groupOrders();
                emptyEl.classList.toggle("hidden", groups.length > 0);
                listEl.innerHTML = "";
                for (const group of groups) {
                    const section = document.createElement("section");
                    const accent = tableAccentIndex(group.tableId);
                    section.className = "table-order-group table-order-group--accent-" + accent +
                        (group.hasIncomplete ? " table-order-group--kitchen" : " table-order-group--settle");
                    section.dataset.tableId = group.tableId;
                    section.innerHTML =
                        '<header class="table-order-group__head">' +
                        '<div><h2 class="table-order-group__title"></h2>' +
                        '<p class="muted table-order-group__meta"><span class="table-round-count"></span> · masa toplamı <strong class="table-total"></strong></p></div>' +
                        '<button type="button" class="btn table-close-check">Hesabı kapat</button></header>' +
                        '<div class="item-grid table-order-group__rounds"></div>';
                    section.querySelector(".table-order-group__title").textContent = group.tableLabel;
                    section.querySelector(".table-round-count").textContent = group.rounds.length + " tur";
                    section.querySelector(".table-total").textContent = formatMoney(group.totalMinor);
                    const closeBtn = section.querySelector(".table-close-check");
                    closeBtn.dataset.tableId = group.tableId;
                    closeBtn.dataset.tableLabel = group.tableLabel;
                    if (group.hasIncomplete) {
                        closeBtn.className = "btn btn-ghost table-close-check table-close-check--muted";
                        closeBtn.title = "Mutfak henüz bitmedi — önce turları ilerletin veya onaylayarak kapatın";
                    } else {
                        closeBtn.className = "btn table-close-check table-close-check--ready";
                        closeBtn.title = "Tüm turlar hazır/servis — hesabı kapatabilirsiniz";
                    }
                    closeBtn.addEventListener("click", () => openCloseCheck(group.tableId, group.tableLabel));
                    const roundsEl = section.querySelector(".table-order-group__rounds");
                    for (const order of group.rounds) {
                        const status = (order.status || "").toLowerCase();
                        const card = document.createElement("article");
                        card.className = "item-card";
                        card.dataset.orderId = order.id;
                        card.innerHTML =
                            '<div class="item-card-top"><h3></h3><span class="price"></span></div>' +
                            (order.itemSummary
                                ? '<p class="order-item-summary"></p>'
                                : "") +
                            '<p class="item-desc">Durum: <strong class="order-status-label"></strong><br />' +
                            'Sipariş: <span class="order-created"></span><br />' +
                            'Güncelleme: <span class="order-changed"></span></p>' +
                            '<div class="item-meta"><span class="badge order-status-code"></span>' +
                            '<a class="linkish order-detail-link">Detay</a>' +
                            (status === "served" || status === "completed" || status === "cancelled"
                                ? ""
                                : '<button type="button" class="linkish order-change-link">Durumu değiştir</button>') +
                            "</div>";
                        card.querySelector("h3").textContent = order.displayNumber;
                        card.querySelector(".price").textContent = formatMoney(order.amountMinor);
                        const summaryElCard = card.querySelector(".order-item-summary");
                        if (summaryElCard) summaryElCard.textContent = order.itemSummary || "";
                        card.querySelector(".order-status-label").textContent = statusTr[status] || order.status;
                        card.querySelector(".order-created").textContent = formatLocal(order.createdAtUtc);
                        card.querySelector(".order-changed").textContent = formatLocal(order.statusChangedAtUtc);
                        const badge = card.querySelector(".order-status-code");
                        badge.textContent = statusTr[status] || order.status;
                        badge.className = "badge order-status-code " + statusBadgeClass(status);
                        card.querySelector(".order-detail-link").href = detailUrl(order);
                        const changeLink = card.querySelector(".order-change-link");
                        if (changeLink) {
                            changeLink.addEventListener("click", () => openStatusChange(order.id));
                        }
                        roundsEl.appendChild(card);
                    }
                    listEl.appendChild(section);
                }
            }

            function upsertOrder(order, options) {
                const silent = options && options.silent;
                if (!order || !order.id) return;
                const status = (order.status || "").toLowerCase();
                const id = order.id;
                const existed = ordersById.has(id);
                const previous = ordersById.get(id);
                if (status === "completed" || status === "cancelled") {
                    ordersById.delete(id);
                    renderOrders();
                    return;
                }
                // Incomplete live payloads without status/display should not invent ghost cards.
                if (!order.status && !order.displayNumber && !order.amountMinor && !previous) {
                    return;
                }
                const merged = {
                    ...previous,
                    ...order,
                    id,
                    tableId: emptyGuid(order.tableId) && previous ? previous.tableId : order.tableId,
                    tableLabel: order.tableLabel || (previous && previous.tableLabel) || "",
                    displayNumber: order.displayNumber || (previous && previous.displayNumber) || "",
                    amountMinor: Number(order.amountMinor ?? (previous && previous.amountMinor) ?? 0),
                    currency: order.currency || (previous && previous.currency) || "TRY",
                    itemSummary: order.itemSummary || (previous && previous.itemSummary) || "",
                    createdAtUtc: order.createdAtUtc || (previous && previous.createdAtUtc) || null,
                    statusChangedAtUtc: order.statusChangedAtUtc || (previous && previous.statusChangedAtUtc) || "",
                    estimatedReadyAtUtc: order.estimatedReadyAtUtc || (previous && previous.estimatedReadyAtUtc) || "",
                    status: order.status || (previous && previous.status) || ""
                };
                if (!merged.status && !merged.displayNumber && !merged.amountMinor) {
                    return;
                }
                ordersById.set(id, merged);
                renderOrders();
                if (!existed && !silent) {
                    if (alerts) alerts.rememberOrderId(id);
                    playAlertChime("order");
                } else if (alerts) {
                    alerts.rememberOrderId(id);
                }
            }

            function openStatusChange(orderId) {
                const order = ordersById.get(orderId);
                if (!order || !statusDialog || !statusSelect) return;
                const targets = allowedStatusTargets(order.status);
                if (targets.length === 0) return;
                activeStatusOrderId = orderId;
                statusTitle.textContent = "Durumu değiştir · " + (order.displayNumber || "");
                statusSummary.textContent = "Mevcut: " + (statusTr[(order.status || "").toLowerCase()] || order.status);
                statusSelect.innerHTML = "";
                targets.forEach((value) => {
                    const option = document.createElement("option");
                    option.value = value;
                    option.textContent = statusOptionLabels[value] || value;
                    statusSelect.appendChild(option);
                });
                statusEta.value = "";
                statusError.classList.add("hidden");
                statusError.textContent = "";
                if (typeof statusDialog.showModal === "function") statusDialog.showModal();
            }

            async function resync() {
                const response = await fetch(apiBase + "/api/v1/management/orders/active", {
                    headers: { Authorization: "Bearer " + accessToken }
                });
                if (!response.ok) throw new Error("resync failed");
                const orders = await response.json();
                ordersById.clear();
                for (const order of orders) ordersById.set(order.id, order);
                renderOrders();
                await resyncServiceRequests();
            }

            let activeCloseTableId = null;

            async function openCloseCheck(tableId, tableLabel) {
                activeCloseTableId = tableId;
                titleEl.textContent = (tableLabel || "Masa") + " · Hesabı kapat";
                summaryEl.textContent = "Turlar yükleniyor…";
                if (roundsDetailEl) roundsDetailEl.innerHTML = "";
                incompleteBox.classList.add("hidden");
                forceBox.checked = false;
                errorEl.classList.add("hidden");
                errorEl.textContent = "";
                noteEl.value = "";
                const cash = form.querySelector('input[name="tender"][value="cash"]');
                if (cash) cash.checked = true;
                if (typeof dialog.showModal === "function") dialog.showModal();

                try {
                    const response = await fetch(
                        apiBase + "/api/v1/management/tables/" + encodeURIComponent(tableId) + "/check",
                        { headers: { Authorization: "Bearer " + accessToken } });
                    if (!response.ok) throw new Error("check_failed");
                    const check = await response.json();
                    const rounds = Array.isArray(check.rounds) ? check.rounds : [];
                    summaryEl.textContent = (check.roundCount || rounds.length) + " tur · " +
                        formatMoney(check.totalAmountMinor || 0);
                    if (roundsDetailEl) {
                        if (rounds.length === 0) {
                            roundsDetailEl.innerHTML = "<p class=\"muted\">Bu masada açık tur yok.</p>";
                        } else {
                            roundsDetailEl.innerHTML = rounds.map(() => {
                                return "<div class=\"close-check-round\">" +
                                    "<div class=\"close-check-round__head\">" +
                                    "<div><strong></strong><span class=\"badge\"></span></div>" +
                                    "<span class=\"price\"></span></div>" +
                                    "<ul class=\"close-check-lines\"></ul></div>";
                            }).join("") +
                                "<p class=\"close-check-grand-total\"><span>Masa toplamı</span><strong></strong></p>";
                            const nodes = roundsDetailEl.querySelectorAll(".close-check-round");
                            rounds.forEach((round, index) => {
                                const status = (round.status || "").toLowerCase();
                                const node = nodes[index];
                                const title = rounds.length > 1
                                    ? ("Tur " + (index + 1) + " · " + round.displayNumber)
                                    : round.displayNumber;
                                node.querySelector("strong").textContent = title;
                                node.querySelector(".price").textContent = formatMoney(round.amountMinor);
                                const badge = node.querySelector(".badge");
                                badge.textContent = statusTr[status] || round.status;
                                badge.className = "badge " + statusBadgeClass(status);
                                const linesEl = node.querySelector(".close-check-lines");
                                const items = Array.isArray(round.items) ? round.items : [];
                                if (items.length === 0) {
                                    linesEl.outerHTML = "<p class=\"muted close-check-lines-empty\">Kalem kaydı yok</p>";
                                } else {
                                    items.forEach((item) => {
                                        const li = document.createElement("li");
                                        const left = document.createElement("span");
                                        left.textContent = item.quantity + "× " + item.name +
                                            (item.note ? " · " + item.note : "");
                                        const right = document.createElement("span");
                                        const lineTotal = Number(item.unitPriceAmountMinor || 0) * Number(item.quantity || 0);
                                        right.textContent = formatMoney(lineTotal);
                                        li.appendChild(left);
                                        li.appendChild(right);
                                        linesEl.appendChild(li);
                                    });
                                }
                            });
                            const grand = roundsDetailEl.querySelector(".close-check-grand-total strong");
                            if (grand) grand.textContent = formatMoney(check.totalAmountMinor || 0);
                        }
                    }
                    incompleteBox.classList.toggle("hidden", !check.hasIncompleteKitchen);
                } catch (error) {
                    summaryEl.textContent = "Turlar yüklenemedi";
                    if (roundsDetailEl) {
                        roundsDetailEl.innerHTML = "<p class=\"alert\">Adisyon detayı alınamadı. Sayfayı yenileyip tekrar deneyin.</p>";
                    }
                }
            }

            listEl.addEventListener("click", (event) => {
                const changeBtn = event.target.closest(".order-change-link");
                if (changeBtn) {
                    event.preventDefault();
                    const card = changeBtn.closest("article.item-card[data-order-id]");
                    if (card) openStatusChange(card.dataset.orderId);
                    return;
                }
                const btn = event.target.closest(".table-close-check");
                if (!btn) return;
                openCloseCheck(btn.dataset.tableId, btn.dataset.tableLabel);
            });

            cancelBtn.addEventListener("click", () => dialog.close());
            if (statusCancel) statusCancel.addEventListener("click", () => statusDialog.close());

            if (statusForm) {
                statusForm.addEventListener("submit", async (event) => {
                    event.preventDefault();
                    if (!activeStatusOrderId) return;
                    const order = ordersById.get(activeStatusOrderId);
                    if (!order) return;
                    statusError.classList.add("hidden");
                    statusError.textContent = "";
                    const nextStatus = statusSelect.value;
                    let estimatedReadyAtUtc = null;
                    const etaRaw = statusEta.value.trim();
                    if (etaRaw) {
                        estimatedReadyAtUtc = parseEtaInput(etaRaw);
                        if (!estimatedReadyAtUtc) {
                            statusError.textContent = "ETA formatı geçersiz. Dakika (15) veya saat (09:23) yazın.";
                            statusError.classList.remove("hidden");
                            return;
                        }
                    }
                    statusSubmit.disabled = true;
                    try {
                        const body = {
                            status: nextStatus,
                            expectedStatusChangedAtUtc: order.statusChangedAtUtc
                        };
                        if (estimatedReadyAtUtc) body.estimatedReadyAtUtc = estimatedReadyAtUtc;
                        const response = await fetch(
                            apiBase + "/api/v1/management/orders/" + encodeURIComponent(order.id) + "/status",
                            {
                                method: "PUT",
                                headers: {
                                    Authorization: "Bearer " + accessToken,
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify(body)
                            });
                        if (!response.ok) {
                            const problem = await response.json().catch(() => ({}));
                            statusError.textContent = problem.detail || problem.title || "Durum güncellenemedi.";
                            statusError.classList.remove("hidden");
                            return;
                        }
                        const updated = await response.json();
                        statusDialog.close();
                        upsertOrder({
                            ...order,
                            ...updated,
                            id: order.id,
                            tableId: emptyGuid(updated.tableId) ? order.tableId : updated.tableId,
                            tableLabel: updated.tableLabel || order.tableLabel,
                            itemSummary: updated.itemSummary || order.itemSummary
                        }, { silent: true });
                        showToast((order.displayNumber || "Sipariş") + " → " + (statusTr[nextStatus] || nextStatus));
                    } catch {
                        statusError.textContent = "Bağlantı hatası. Tekrar deneyin.";
                        statusError.classList.remove("hidden");
                    } finally {
                        statusSubmit.disabled = false;
                    }
                });
            }

            form.addEventListener("submit", async (event) => {
                event.preventDefault();
                if (!activeCloseTableId) return;
                errorEl.classList.add("hidden");
                const tender = (form.querySelector('input[name="tender"]:checked') || {}).value || "cash";
                const confirmIncompleteKitchen = forceBox.checked;
                const note = noteEl.value.trim() || null;
                const submitBtn = document.getElementById("close-check-submit");
                submitBtn.disabled = true;
                try {
                    const response = await fetch(
                        apiBase + "/api/v1/management/tables/" + encodeURIComponent(activeCloseTableId) + "/close-check",
                        {
                            method: "POST",
                            headers: {
                                Authorization: "Bearer " + accessToken,
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ tender, confirmIncompleteKitchen, note })
                        });
                    if (response.status === 409) {
                        const problem = await response.json().catch(() => ({}));
                        incompleteBox.classList.remove("hidden");
                        errorEl.textContent = problem.detail || problem.title || "Mutfakta tamamlanmamış tur var. Onay kutusunu işaretleyin.";
                        errorEl.classList.remove("hidden");
                        return;
                    }
                    if (!response.ok) {
                        const problem = await response.json().catch(() => ({}));
                        errorEl.textContent = problem.detail || problem.title || "Hesap kapatılamadı.";
                        errorEl.classList.remove("hidden");
                        return;
                    }
                    const result = await response.json();
                    dialog.close();
                    for (const id of (result.closedOrderIds || [])) ordersById.delete(id);
                    renderOrders();
                    const forced = result.forcedIncompleteKitchen ? " (mutfak onaysız kapatıldı)" : "";
                    showToast((result.tableLabel || "Masa") + " hesabı kapatıldı · " + formatMoney(result.totalAmountMinor) + forced);
                } catch {
                    errorEl.textContent = "Bağlantı hatası. Tekrar deneyin.";
                    errorEl.classList.remove("hidden");
                } finally {
                    submitBtn.disabled = false;
                }
            });

            function syncServiceEmpty() {
                const has = serviceGrid.querySelectorAll("[data-request-id]").length > 0;
                serviceEmpty.classList.toggle("hidden", has);
            }

            function upsertServiceRequest(request, options) {
                const silent = options && options.silent;
                if ((request.status || "").toLowerCase() !== "open") {
                    const existing = serviceGrid.querySelector('[data-request-id="' + request.id + '"]');
                    if (existing) existing.remove();
                    syncServiceEmpty();
                    return;
                }

                let card = serviceGrid.querySelector('[data-request-id="' + request.id + '"]');
                const isNew = !card;
                if (!card) {
                    card = document.createElement("article");
                    card.className = "item-card";
                    card.dataset.requestId = request.id;
                    card.innerHTML =
                        '<div class="item-card-top"><h3 class="request-table"></h3><span class="badge request-type"></span></div>' +
                        '<p class="item-desc request-time"></p>' +
                        '<div class="item-meta"><button type="button" class="btn request-complete">Tamamla</button></div>';
                    serviceGrid.prepend(card);
                    card.querySelector(".request-complete").addEventListener("click", async () => {
                        const response = await fetch(apiBase + "/api/v1/management/service-requests/" + request.id + "/complete", {
                            method: "POST",
                            headers: { Authorization: "Bearer " + accessToken }
                        });
                        if (response.ok) {
                            card.remove();
                            syncServiceEmpty();
                        }
                    });
                }

                const typeKey = (request.type || "").toLowerCase();
                const typeBadge = card.querySelector(".request-type");
                card.querySelector(".request-table").textContent = request.tableLabel;
                typeBadge.textContent = requestTypeTr[request.type] || request.type;
                typeBadge.className = "badge request-type " + (
                    typeKey === "bill" ? "badge-bill"
                    : typeKey === "waiter" ? "badge-waiter"
                    : "badge-warn"
                );
                card.querySelector(".request-time").textContent = formatLocal(request.createdAtUtc);
                syncServiceEmpty();
                if (isNew && !silent) {
                    const kind = (request.type || "").toLowerCase() === "bill"
                        ? "bill"
                        : (request.type || "").toLowerCase() === "waiter"
                            ? "waiter"
                            : "service";
                    playAlertChime(kind);
                }
            }

            async function resyncServiceRequests() {
                const response = await fetch(apiBase + "/api/v1/management/service-requests/open", {
                    headers: { Authorization: "Bearer " + accessToken }
                });
                if (!response.ok) return;
                const items = await response.json();
                serviceGrid.querySelectorAll("[data-request-id]").forEach((el) => el.remove());
                for (const item of items) upsertServiceRequest(item, { silent: true });
                syncServiceEmpty();
            }

            seedFromDom();

            if (!apiBase || !accessToken || !window.signalR) {
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl(apiBase + "/hubs/v1/management-orders", {
                    accessTokenFactory: () => accessToken
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            connection.on("orderStatusChanged", (order) => upsertOrder(order));
            connection.on("serviceRequestCreated", (request) => upsertServiceRequest(request));
            connection.onreconnecting(() => setLiveState("Bağlantı yeniden kuruluyor…"));
            connection.onreconnected(async () => {
                setLiveState("Canlı · yeniden senkronize edildi");
                try { await resync(); } catch { setLiveState("Canlı · senkron uyarısı"); }
            });
            connection.onclose(() => setLiveState("Çevrimdışı · sayfayı yenileyin"));

            connection.start()
                .then(async () => {
                    setLiveState("Canlı · sipariş ve garson çağrıları anında gelir (yalnız bu şube)");
                    try { await resyncServiceRequests(); } catch { /* ignore */ }
                })
                .catch(() => setLiveState("Canlı bağlantı kurulamadı · sayfayı yenileyerek güncelleyin"));
        })();
    </script>
}
