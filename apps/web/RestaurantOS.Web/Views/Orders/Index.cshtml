@model IReadOnlyList<RestaurantOS.Web.Models.OrderListItemViewModel>
@using Microsoft.Extensions.Options
@using RestaurantOS.Web.Data
@inject IWebApiExecuter Api
@inject IOptions<ApiOptions> ApiOptions
@{
    ViewData["Title"] = "Aktif siparişler";
    var apiBase = ApiOptions.Value.BaseUrl.TrimEnd('/');
    var accessToken = Api.CurrentToken?.AccessToken ?? string.Empty;
    string StatusTr(string status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "Alındı",
        "accepted" => "Onaylandı",
        "preparing" => "Hazırlanıyor",
        "ready" => "Hazır",
        "served" => "Servis edildi",
        "completed" => "Tamamlandı",
        "cancelled" => "İptal",
        _ => status ?? "—"
    };
}

<div class="page-head">
    <div>
        <h1>Aktif siparişler</h1>
        <p class="muted" id="orders-live-status" role="status">Canlı bağlantı kuruluyor…</p>
    </div>
    <div class="page-head-actions">
        <button type="button" class="btn btn-ghost" id="orders-sound-toggle" aria-pressed="true">
            Zil sesi: Açık
        </button>
    </div>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert" role="alert">@error</div>
}

<section class="panel" style="margin-bottom:1.25rem">
    <div class="page-head" style="margin-bottom:0.75rem">
        <h2 style="margin:0;font-size:1.1rem">Garson / servis çağrıları</h2>
        <p class="muted" id="service-requests-empty">Açık çağrı yok.</p>
    </div>
    <div class="item-grid" id="service-requests-grid"></div>
</section>

<div id="orders-empty" class="@(Model.Count == 0 ? null : "hidden")">
    <p class="muted">Şu anda aktif sipariş yok. Yeni siparişler anında burada görünür.</p>
</div>

<div class="item-grid" id="orders-grid">
    @foreach (var order in Model)
    {
        <article class="item-card" data-order-id="@order.Id" data-status="@order.Status" data-status-changed="@order.StatusChangedAtUtc.ToString("O")">
            <div class="item-card-top">
                <h3>@order.DisplayNumber</h3>
                <span class="price">₺@((order.AmountMinor / 100m).ToString("N2"))</span>
            </div>
            <p class="item-desc">
                Masa: <strong class="order-table-label">@(string.IsNullOrWhiteSpace(order.TableLabel) ? "—" : order.TableLabel)</strong><br />
                Durum: <strong class="order-status-label">@StatusTr(order.Status)</strong><br />
                Sipariş: <span class="order-created">@(order.CreatedAtUtc?.ToLocalTime().ToString("g") ?? "—")</span><br />
                Güncelleme: <span class="order-changed">@order.StatusChangedAtUtc.ToLocalTime().ToString("g")</span>
            </p>
            <div class="item-meta">
                <span class="badge badge-warn order-status-code">@order.Status</span>
                <a class="linkish"
                   asp-action="Detail"
                   asp-route-id="@order.Id">Detay</a>
                <a class="linkish order-change-link"
                   asp-action="ChangeStatus"
                   asp-route-id="@order.Id">Durumu değiştir</a>
            </div>
        </article>
    }
</div>

@section Scripts {
    <script>
        (() => {
            window.__restaurantOsOrdersPageActive = true;
            const alerts = window.RestaurantOsAlerts;
            const apiBase = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(apiBase));
            const accessToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(accessToken));
            const statusEl = document.getElementById("orders-live-status");
            const grid = document.getElementById("orders-grid");
            const emptyEl = document.getElementById("orders-empty");
            const serviceGrid = document.getElementById("service-requests-grid");
            const serviceEmpty = document.getElementById("service-requests-empty");
            const soundToggle = document.getElementById("orders-sound-toggle");
            if (!apiBase || !accessToken || !window.signalR) {
                if (statusEl) statusEl.textContent = "Canlı bağlantı kullanılamıyor; sayfayı yenileyerek güncelleyin.";
                return;
            }

            const statusTr = {
                submitted: "Alındı",
                accepted: "Onaylandı",
                preparing: "Hazırlanıyor",
                ready: "Hazır",
                served: "Servis edildi",
                completed: "Tamamlandı",
                cancelled: "İptal"
            };
            const requestTypeTr = {
                waiter: "Garson",
                bill: "Hesap",
                water: "Su",
                cutlery: "Çatal-bıçak",
                napkin: "Peçete",
                other: "Diğer"
            };

            function syncSoundToggle(state) {
                if (!soundToggle || !alerts) return;
                const enabled = state ? state.soundEnabled : alerts.isSoundEnabled();
                const unlocked = state ? state.audioUnlocked : alerts.isAudioUnlocked();
                soundToggle.setAttribute("aria-pressed", enabled ? "true" : "false");
                soundToggle.textContent = enabled
                    ? (unlocked ? "Zil sesi: Açık" : "Zil sesi: Açık (etkileşim bekleniyor)")
                    : "Zil sesi: Kapalı";
            }

            function playAlertChime(kind, options) {
                if (alerts) alerts.play(kind, options);
            }

            if (alerts) {
                alerts.onSoundState(syncSoundToggle);
                if (soundToggle) {
                    soundToggle.addEventListener("click", async () => {
                        alerts.unlock();
                        const next = !alerts.isSoundEnabled();
                        alerts.setSoundEnabled(next);
                        if (next) {
                            await alerts.requestNotificationPermission();
                            playAlertChime("order", { force: true });
                        }
                        syncSoundToggle();
                    });
                }
            } else {
                syncSoundToggle({ soundEnabled: true, audioUnlocked: false });
            }

            // Seed known ids so initial paint does not chime.
            if (alerts) {
                const seed = [];
                grid.querySelectorAll("[data-order-id]").forEach((el) => seed.push(el.dataset.orderId));
                alerts.seedKnownOrders(seed);
            }

            function formatMoney(amountMinor) {
                return "₺" + (Number(amountMinor) / 100).toLocaleString("tr-TR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function formatLocal(iso) {
                if (!iso) return "—";
                const d = new Date(iso);
                return Number.isNaN(d.getTime()) ? "—" : d.toLocaleString("tr-TR");
            }

            function setLiveState(text) {
                if (statusEl) statusEl.textContent = text;
            }

            function syncEmpty() {
                const hasCards = grid.querySelectorAll("[data-order-id]").length > 0;
                emptyEl.classList.toggle("hidden", hasCards);
            }

            function detailUrl(order) {
                return "/Orders/Detail?id=" + encodeURIComponent(order.id);
            }

            function changeStatusUrl(order) {
                return "/Orders/ChangeStatus?id=" + encodeURIComponent(order.id);
            }

            function upsertOrder(order, options) {
                const silent = options && options.silent;
                const status = (order.status || "").toLowerCase();
                if (status === "completed" || status === "cancelled") {
                    const existing = grid.querySelector('[data-order-id="' + order.id + '"]');
                    if (existing) existing.remove();
                    syncEmpty();
                    return;
                }

                let card = grid.querySelector('[data-order-id="' + order.id + '"]');
                const isNew = !card;
                if (!card) {
                    card = document.createElement("article");
                    card.className = "item-card";
                    card.dataset.orderId = order.id;
                    card.innerHTML =
                        '<div class="item-card-top"><h3></h3><span class="price"></span></div>' +
                        '<p class="item-desc">Masa: <strong class="order-table-label"></strong><br />' +
                        'Durum: <strong class="order-status-label"></strong><br />' +
                        'Sipariş: <span class="order-created"></span><br />' +
                        'Güncelleme: <span class="order-changed"></span></p>' +
                        '<div class="item-meta"><span class="badge badge-warn order-status-code"></span>' +
                        '<a class="linkish order-detail-link">Detay</a>' +
                        '<a class="linkish order-change-link">Durumu değiştir</a></div>';
                    grid.prepend(card);
                }

                card.dataset.status = status;
                card.dataset.statusChanged = order.statusChangedAtUtc;
                card.querySelector("h3").textContent = order.displayNumber;
                card.querySelector(".price").textContent = formatMoney(order.amountMinor);
                card.querySelector(".order-table-label").textContent = order.tableLabel || "—";
                card.querySelector(".order-status-label").textContent = statusTr[status] || order.status;
                card.querySelector(".order-created").textContent = formatLocal(order.createdAtUtc);
                card.querySelector(".order-changed").textContent = formatLocal(order.statusChangedAtUtc);
                card.querySelector(".order-status-code").textContent = order.status;
                const detailLink = card.querySelector(".order-detail-link");
                detailLink.href = detailUrl(order);
                const link = card.querySelector(".order-change-link");
                link.href = changeStatusUrl(order);
                syncEmpty();
                if (isNew && !silent) {
                    if (alerts) alerts.rememberOrderId(order.id);
                    playAlertChime("order");
                } else if (alerts) {
                    alerts.rememberOrderId(order.id);
                }
            }

            async function resync() {
                const response = await fetch(apiBase + "/api/v1/management/orders/active", {
                    headers: { Authorization: "Bearer " + accessToken }
                });
                if (!response.ok) throw new Error("resync failed");
                const orders = await response.json();
                grid.querySelectorAll("[data-order-id]").forEach((el) => el.remove());
                for (const order of orders) {
                    upsertOrder(order, { silent: true });
                }
                syncEmpty();
                await resyncServiceRequests();
            }

            function syncServiceEmpty() {
                const has = serviceGrid.querySelectorAll("[data-request-id]").length > 0;
                serviceEmpty.classList.toggle("hidden", has);
            }

            function upsertServiceRequest(request, options) {
                const silent = options && options.silent;
                if ((request.status || "").toLowerCase() !== "open") {
                    const existing = serviceGrid.querySelector('[data-request-id="' + request.id + '"]');
                    if (existing) existing.remove();
                    syncServiceEmpty();
                    return;
                }

                let card = serviceGrid.querySelector('[data-request-id="' + request.id + '"]');
                const isNew = !card;
                if (!card) {
                    card = document.createElement("article");
                    card.className = "item-card";
                    card.dataset.requestId = request.id;
                    card.innerHTML =
                        '<div class="item-card-top"><h3 class="request-table"></h3><span class="badge badge-warn request-type"></span></div>' +
                        '<p class="item-desc request-time"></p>' +
                        '<div class="item-meta"><button type="button" class="btn request-complete">Tamamla</button></div>';
                    serviceGrid.prepend(card);
                    card.querySelector(".request-complete").addEventListener("click", async () => {
                        const response = await fetch(apiBase + "/api/v1/management/service-requests/" + request.id + "/complete", {
                            method: "POST",
                            headers: { Authorization: "Bearer " + accessToken }
                        });
                        if (response.ok) {
                            card.remove();
                            syncServiceEmpty();
                        }
                    });
                }

                card.querySelector(".request-table").textContent = request.tableLabel;
                card.querySelector(".request-type").textContent = requestTypeTr[request.type] || request.type;
                card.querySelector(".request-time").textContent = formatLocal(request.createdAtUtc);
                syncServiceEmpty();
                if (isNew && !silent) {
                    const kind = (request.type || "").toLowerCase() === "bill"
                        ? "bill"
                        : (request.type || "").toLowerCase() === "waiter"
                            ? "waiter"
                            : "service";
                    playAlertChime(kind);
                }
            }

            async function resyncServiceRequests() {
                const response = await fetch(apiBase + "/api/v1/management/service-requests/open", {
                    headers: { Authorization: "Bearer " + accessToken }
                });
                if (!response.ok) return;
                const items = await response.json();
                serviceGrid.querySelectorAll("[data-request-id]").forEach((el) => el.remove());
                for (const item of items) upsertServiceRequest(item, { silent: true });
                syncServiceEmpty();
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl(apiBase + "/hubs/v1/management-orders", {
                    accessTokenFactory: () => accessToken
                })
                .withAutomaticReconnect([0, 2000, 5000, 10000, 30000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            connection.on("orderStatusChanged", (order) => upsertOrder(order));
            connection.on("serviceRequestCreated", (request) => upsertServiceRequest(request));
            connection.onreconnecting(() => setLiveState("Bağlantı yeniden kuruluyor…"));
            connection.onreconnected(async () => {
                setLiveState("Canlı · yeniden senkronize edildi");
                try { await resync(); } catch { setLiveState("Canlı · senkron uyarısı"); }
            });
            connection.onclose(() => setLiveState("Çevrimdışı · sayfayı yenileyin"));

            connection.start()
                .then(async () => {
                    setLiveState("Canlı · sipariş ve garson çağrıları anında gelir (yalnız bu şube)");
                    try { await resyncServiceRequests(); } catch { /* ignore */ }
                })
                .catch(() => setLiveState("Canlı bağlantı kurulamadı · sayfayı yenileyerek güncelleyin"));
        })();
    </script>
}

