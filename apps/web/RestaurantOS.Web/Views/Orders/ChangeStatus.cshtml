@model RestaurantOS.Web.Models.ChangeOrderStatusViewModel
@{
    ViewData["Title"] = "Sipariş durumu";
    var currentEta = Model.CurrentEstimatedReadyAtUtc?.ToLocalTime().ToString("HH:mm") ?? "—";
}

<h1>Durum güncelle · @Model.DisplayNumber</h1>
<p class="muted">Mevcut durum: @StatusTr(Model.CurrentStatus)</p>
<p class="muted">İleri adımlara atlayabilirsiniz; atlanan adımlar tamamlanmış sayılır.</p>

@functions {
    string StatusTr(string status) => status?.ToLowerInvariant() switch
    {
        "submitted" => "Alındı",
        "accepted" => "Onaylandı",
        "preparing" => "Hazırlanıyor",
        "ready" => "Hazır / pasa çıktı",
        "served" => "Servis edildi",
        "completed" => "Hesap kapandı",
        "cancelled" => "İptal",
        _ => status ?? "—"
    };

    static int StatusRank(string status) => status.ToLowerInvariant() switch
    {
        "submitted" => 0,
        "accepted" => 1,
        "preparing" => 2,
        "ready" => 3,
        "served" => 4,
        "completed" => 5,
        _ => -1,
    };

    static bool IsAllowedTarget(string current, string candidate)
    {
        current = current.ToLowerInvariant();
        candidate = candidate.ToLowerInvariant();
        if (candidate == "cancelled")
        {
            return current is "submitted" or "accepted" or "preparing";
        }

        // Completed is reserved for close-check settlement, not manual kitchen steps.
        if (candidate == "completed")
        {
            return false;
        }

        return StatusRank(candidate) > StatusRank(current);
    }
}

<div asp-validation-summary="All" class="alert"></div>

<form asp-action="ChangeStatus" method="post" class="stack">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="OrderId" />
    <input type="hidden" asp-for="DisplayNumber" />
    <input type="hidden" asp-for="CurrentStatus" />
    <input type="hidden" name="ExpectedStatusChangedAtUtc" value="@Model.ExpectedStatusChangedAtUtc.ToString("O", System.Globalization.CultureInfo.InvariantCulture)" />
    <label>
        Yeni durum
        <select asp-for="Status">
            @{
                var options = new (string Value, string Label)[]
                {
                    ("accepted", "Onaylandı"),
                    ("preparing", "Hazırlanıyor"),
                    ("ready", "Hazır / pasa çıktı"),
                    ("served", "Servis edildi"),
                    ("cancelled", "İptal"),
                };
            }
            @foreach (var option in options)
            {
                if (IsAllowedTarget(Model.CurrentStatus, option.Value))
                {
                    <option value="@option.Value">@option.Label</option>
                }
            }
        </select>
    </label>
    <label>
        Tahmini hazır (isteğe bağlı)
        <input asp-for="EstimatedReadyInput"
               inputmode="numeric"
               autocomplete="off"
               placeholder="örn. 15 veya 09:23"
               maxlength="8" />
    </label>
    <p class="muted">
        Dakika yazın (<strong>15</strong> = 15 dk sonra) veya saat yazın (<strong>9:23</strong> / <strong>09:23</strong>).
        Saat geçmişse ertesi güne alınır. Boş bırakırsanız mevcut ETA korunur (Hazır/Servis’te şu an).
        Mevcut ETA: @currentEta
    </p>
    <p class="muted">Hesap kapanışı bu ekrandan değil; masa kartındaki <strong>Hesabı kapat</strong> ile yapılır.</p>
    <button type="submit" class="btn">Kaydet</button>
    <a asp-action="Index">İptal</a>
</form>
