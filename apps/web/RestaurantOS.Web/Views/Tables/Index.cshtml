@model IReadOnlyList<RestaurantOS.Web.Models.TableListItemViewModel>
@{
    ViewData["Title"] = "Masalar";
    var canEditTables = ViewData["CanEditTables"] as bool? == true;
}

<div class="page-head">
    <div>
        <h1>Masalar</h1>
        @if (ViewData["TableQuota"] is string quota)
        {
            <p class="muted">Kota: @quota masa</p>
        }
    </div>
    @if (canEditTables)
    {
        @if (ViewData["TableQuotaReached"] as bool? == true)
        {
            <a class="btn btn-ghost" asp-action="Create" title="Plan limitine ulaşıldı">Yeni masa</a>
        }
        else
        {
            <a class="btn" asp-action="Create">Yeni masa</a>
        }
    }
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert success" role="status">@message</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert" role="alert">@error</div>
}

@if (Model.Count == 0)
{
    <p class="muted">Henüz masa tanımlanmamış.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Etiket</th>
                <th>Operasyon durumu</th>
                <th>Kayıt</th>
                <th>Aktif QR</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var table in Model)
        {
            var statusLabel = table.OperationalStatus switch
            {
                "has_pending_order" => "Bekleyen sipariş",
                "occupied" => "Dolu",
                _ => "Müsait",
            };
            <tr>
                <td>@table.Label</td>
                <td><span class="badge">@statusLabel</span></td>
                <td>@(table.IsActive ? "Aktif" : "Kapalı")</td>
                <td>@table.ActiveQrCount</td>
                <td class="table-actions">
                    @if (canEditTables)
                    {
                        <form asp-action="GenerateQr" asp-route-id="@table.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="linkish">QR üret</button>
                        </form>
                    }
                    @if (table.OperationalStatus is "occupied" or "has_pending_order")
                    {
                        <form asp-action="Release" asp-route-id="@table.Id" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="linkish">Masayı boşalt</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
